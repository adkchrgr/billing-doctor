# Claude API key (only needed for `--agent` mode; offline triage works without it)
ANTHROPIC_API_KEY=
# Metronome key for the account you are DIAGNOSING (sandbox recommended)
METRONOME_API_KEY=
# Metronome key for Billing Doctor's OWN billing account (self-metering). Leave blank for dry-run.
BILLING_DOCTOR_METERING_KEY=
# Which Billing Doctor customer is running this (ingest alias in your own Metronome account)
BILLING_DOCTOR_TENANT=demo-tenant
