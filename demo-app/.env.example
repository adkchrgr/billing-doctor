# --- Where usage goes -------------------------------------------------------
# Local fake (run `npm run fake-metronome` in the project root first):
METRONOME_BASE_URL=http://localhost:4010
METRONOME_BEARER_TOKEN=local-dev-token
# Real sandbox: delete METRONOME_BASE_URL and paste your sandbox API token above.

# --- The customer this app bills --------------------------------------------
# Ingest alias the app sends as customer_id (correct behavior)
DEMO_CUSTOMER_ALIAS=acme-123
# The app's own internal account key (sending this instead is one of the bugs)
DEMO_CUSTOMER_EXTERNAL_ID=acme-prod
# Metronome customer ID (Billing Doctor needs this). Fake server: cust_acme.
# Real sandbox: printed by setup_sandbox.py
DEMO_CUSTOMER_ID=cust_acme
